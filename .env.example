# Optional. Without it the app still returns full rule-based results; only the AI summary panel is disabled.
ANTHROPIC_API_KEY=

# Optional. Secret for signing summary tokens. If unset, a key is derived from ANTHROPIC_API_KEY.
SUMMARY_SIGNING_SECRET=
# Optional. Maximum AI summaries per day across all users (default 300).
SUMMARY_DAILY_LIMIT=
# Optional. Upstash Redis REST URL and token (or the Vercel KV pair below) for shared rate limits and the summary cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional. Set to 1 only behind a proxy you control that appends the real client address to x-forwarded-for.
TRUST_PROXY=

# Optional. Analytics provider: plausible or vercel. Leave empty for no analytics (nothing is loaded or sent).
NEXT_PUBLIC_ANALYTICS=
# Optional. Your site domain as registered in Plausible, for example example.com. Only used when the provider is plausible.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
